bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
drogonsec

# Build output
dist/

# Test files
*.test
*.out
coverage.out
coverage.html

# Go workspace
go.work
go.work.sum

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Secrets - NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
config.local.yaml
secrets.yaml
configs/ai.yaml

